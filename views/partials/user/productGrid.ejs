<% variants.forEach(variant=> { %>
    <div class="product-card">

        <div class="wishlist" data-product-id="<%= variant._id %>" data-variant-id="<%= variant.variants._id %>">
            <i
                class="fa fa-heart <%= (wishlistVariantIds || []).includes(variant.variants._id.toString()) ? 'active' : '' %>"></i>
        </div>

        <a href="/product/<%= variant._id %>/<%= variant.variants._id %>" class="product-link">
            <div class="product-image">
                <% if (variant.variants.stock===0) { %>
                    <div class="out-of-stock-label">Out of Stock</div>
                    <% } %>

                        <img src="<%= variant.variants.images[0] %>" class="product-img" alt="<%= variant.name %>">
            </div>

            <div class="product-info">
                <h3 class="product-title">
                    <%= `${variant.name} with ${variant.variants.dial_color} dial and ${variant.variants.strap_color}
                        strap` %>
                </h3>
                <p class="brand">
                    Brand: <%= variant.brand?.name %>
                </p>
            </div>
            <div class="price-section">
                                <% if(variant.discount> 0) { %>

                                    <!-- Original Price -->
                                    <span class="original-price">₹<%= variant.price %></span>

                                    <!-- Discounted Price -->
                                    <span class="final-price">₹<%= variant.finalPrice %></span>

                                    <!-- Discount Badge -->
                                    <span class="discount-badge">
                                        ₹<%= variant.discount %> OFF
                                    </span>

                                    <% } else { %>

                                        <!-- Normal Price -->
                                        <span class="price">₹<%= variant.price %></span>

                                        <% } %>
                            </div>
        </a>

        <button class="add-cart-btn" data-variant-id="<%= variant.variants._id %>" data-product-id="<%= variant._id %>"
            <%=variant.variants.stock===0 ? 'disabled' : '' %>>
            Add to Cart
        </button>

    </div>


    <% }) %>