<%- include("../partials/user/header", { title: "Payment Failed", hideNavBar: true }) %>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

<style>
    body {
        background: #f4f5f7;
    }

    .failed-container {
        min-height: 80vh;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .failed-card {
        background: #ffffff;
        border-radius: 20px;
        padding: 50px 40px;
        text-align: center;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.08);
        max-width: 600px;
        width: 100%;
        transition: 0.3s ease;
    }

    .failed-card:hover {
        transform: translateY(-5px);
    }

    .failed-icon {
        font-size: 70px;
        color: #dc3545;
        margin-bottom: 20px;
    }

    .failed-title {
        font-weight: 600;
        font-size: 28px;
        margin-bottom: 10px;
    }

    .failed-text {
        color: #6c757d;
        margin-bottom: 25px;
    }

    .order-id {
        background: #fafafa;
        padding: 12px 20px;
        border-radius: 10px;
        font-weight: 500;
        margin-bottom: 30px;
        display: inline-block;
    }

    .btn-retry {
        background: #dc3545;
        border: none;
        color: #fff;
        padding: 12px 25px;
        border-radius: 30px;
        font-weight: 500;
        transition: 0.3s ease;
    }

    .btn-outline-secondary {
        padding: 12px 25px;
        border-radius: 30px;
        font-weight: 500;
    }

    .btn-group-custom {
        display: flex;
        justify-content: center;
        gap: 15px;
        flex-wrap: wrap;
    }
</style>

<div class="container failed-container">
    <div class="failed-card">

        <!-- Icon -->
        <div class="failed-icon">
            ❌
        </div>

        <div class="failed-title">
            Payment Failed
        </div>

        <p class="failed-text">
            Unfortunately, your payment could not be processed.  
            Please try again or choose another payment method.
        </p>

        <!-- Order ID -->
        <div class="order-id">
            Order ID: <strong><%= orderId %></strong>
        </div>

        <!-- Buttons -->
        <div class="btn-group-custom">

            <a href="/retry-payment/<%= order_id %>" class="btn btn-retry">
                Retry Payment
            </a>

            <a href="/orders" class="btn btn-outline-secondary">
                View Orders
            </a>

            <a href="/products" class="btn btn-outline-secondary">
                Continue Shopping
            </a>

        </div>

    </div>
</div>

<%- include("../partials/user/footer") %>