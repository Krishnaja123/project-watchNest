<%- include("../partials/user/header", { title: "My Profile", hideNavBar: true }) %>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="/css/user/editProfile.css">
<link rel="stylesheet" href="/css/user/userSidebar.css">

<div class="container mt-3">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/home">Home</a></li>
            <li class="breadcrumb-item active" aria-current="page">My Profile</li>
        </ol>
    </nav>
</div>

<div class="profile-layout">

    <%- include("../partials/user/userSidebar") %>

    <div class="profile-main">

        <h1 class="main-title">My Profile</h1>

        <div class="card">

            <div class="card-header">
                <h2>Profile Details</h2>
            </div>

            <div class="card-body">

                <!-- Avatar -->
                <div class="mb-4 text-center">
                    <% if (user.profileImage) { %>
                        <img src="<%= user.profileImage %>" class="rounded-circle" width="100" height="100">
                    <% } else { %>
                        <div class="rounded-circle bg-light d-flex align-items-center justify-content-center mx-auto"
                            style="width: 100px; height: 100px; font-size: 32px;">
                            <%= user.username ? user.username.charAt(0).toUpperCase() : "U" %>
                        </div>
                    <% } %>
                </div>

                <!-- Info -->
                <div class="mb-3">
                    <label class="form-label">Name</label>
                    <p class="form-control"><%= user.username || "Not available" %></p>
                </div>

                <div class="mb-3">
                    <label class="form-label">Email</label>
                    <p class="form-control"><%= user.email || "Not available" %></p>
                </div>

                <!-- Actions -->
                <div class="d-flex gap-2">
                    <a href="/profile/change-username" class="btn btn-outline-primary">Change Name</a>
                    <a href="/profile/change-email" class="btn btn-outline-primary">Change Email</a>
                    <a href="/profile/change-password" class="btn btn-danger">Change Password</a>
                </div>

                <hr>

                <!-- Upload -->
                <form action="/profile/upload" method="POST" enctype="multipart/form-data">

                    <label class="form-label">Update Profile Picture</label>

                    <div class="d-flex align-items-center gap-2">
                        <input type="file" name="profilePicture" id="profileImage" class="form-control">
                        <small class="text-muted" id="imageError"></small>
                        <button type="submit" class="btn btn-primary">
                            Upload
                        </button>
                    </div>

                </form>

            </div>
        </div>

    </div>
</div>

<script>
    document.getElementById("profileImage").addEventListener("change", function () {

    const file = this.files[0];
    const error = document.getElementById("imageError");

    if (!file) return;

    const allowedTypes = ["image/jpeg", "image/png", "image/jpg"];
    const maxSize = 2 * 1024 * 1024; // 2MB

    if (!allowedTypes.includes(file.type)) {
        error.textContent = "Only JPG, JPEG, and PNG images are allowed.";
        this.value = "";
        return;
    }

    if (file.size > maxSize) {
        error.textContent = "Image size must be less than 2MB.";
        this.value = "";
        return;
    }

    error.textContent = "";
});

const message = "<%= message %>";
            const type = "<%= type %>";
            if (message) {
                Swal.fire({
                    title: type,
                    icon: type,
                    text: message,
                    confirmButtonColor: '#007bff',
                    timer: 2000,
                    timerProgressBar: true,
                    showConfirmButton: false
                });
            }
</script>