<%- include("../partials/user/header") %>

<link rel="stylesheet" href="/css/user/profile.css">
<link rel="stylesheet" href="/css/user/userSidebar.css">


<div class="profile-layout">

    <!-- Sidebar -->
    <%- include("../partials/user/userSidebar") %>

    <!-- Main Content -->
    <div class="profile-main">

        <div class="profile-grid">

            <!-- LEFT CARD -->
            <div class="card">
                <div class="card-header">
                    <h2>Personal Information</h2>
                </div>

                <div class="card-body">

                    <div class="info-field">
                        <label>Name</label>
                        <div class="value"><%= user.username %></div>
                        <a href="/profile/change-username" class="btn btn-outline">Change Name</a>
                    </div>

                    <div class="info-field">
                        <label>Email</label>
                        <div class="value"><%= user.email %></div>
                        <a href="/profile/change-email" class="btn btn-outline">Change Email</a>
                    </div>

                    <div class="button-group">
                        <button class="btn btn-danger">Change Password</button>
                    </div>

                </div>
            </div>


            <!-- RIGHT CARD -->
            <div class="card">
                <div class="card-header">
                    <h2>Update Profile Picture</h2>
                </div>

                <div class="card-body center">

                    <div class="avatar-circle">
                        <% if (user.profilePicture) { %>
                            <img src="<%= user.profilePicture %>" class="avatar-img">
                        <% } else { %>
                            <span><%= user.initials || "K" %></span>
                        <% } %>
                    </div>

                    <form action="/profile/upload" method="POST" enctype="multipart/form-data">

                        <label class="file-label">
                            Choose File
                            <input type="file" name="profilePicture" hidden>
                        </label>

                        <button type="submit" class="btn btn-primary upload-btn">
                            ↑ Upload
                        </button>

                    </form>

                </div>
            </div>

        </div>

    </div>
</div>