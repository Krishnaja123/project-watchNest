<%- include("../partials/user/header", { title: "Your Orders" , hideNavBar: true }) %>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/user/profile.css">
    <link rel="stylesheet" href="/css/user/userSidebar.css">

    <!-- Breadcrumb -->
    <div class="container mt-3">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item">
                    <a href="/home">Home</a>
                </li>
                <li class="breadcrumb-item active">Your Orders</li>
            </ol>
        </nav>
    </div>

    <div class="profile-layout">

        <%- include("../partials/user/userSidebar") %>

            <div class="profile-main">

                <h1 class="main-title">Your Orders</h1>

                <!-- SEARCH -->
                <div class="row mb-3">
                    <div class="col-md-6">
                        <form id="searchForm" action="/orders" method="GET" class="d-flex">
                            <div class="position-relative w-100">
                                <input type="text" id="searchInput" name="search" value="<%= search || '' %>"
                                    class="form-control pe-5" placeholder="Search by Order ID">

                                <span id="clearBtn"
                                    style="position:absolute; right:10px; top:50%; transform:translateY(-50%); cursor:pointer; display:none;">
                                    ✖
                                </span>
                            </div>

                            <button class="btn btn-dark ms-2">Search</button>
                        </form>
                    </div>
                </div>

                <% if (orders.length===0) { %>
                    <div class="alert-box">No orders found.</div>
                    <% } %>

                        <!-- ORDERS -->
                        <% orders.forEach(data=> { %>

                            <div class="card mb-4">
                                <div class="card-body">

                                    <!-- ORDER HEADER -->
                                    <div class="row mb-3">
                                        <div class="col-md-2">
                                            <small>ORDER PLACED</small><br>
                                            <strong>
                                                <%= new Date(data.createdAt).toDateString() %>
                                            </strong>
                                        </div>

                                        <div class="col-md-2">
                                            <small>ORDER ID</small><br>
                                            <strong>
                                                <%= data.orderId %>
                                            </strong>
                                        </div>

                                        <div class="col-md-2">
                                            <small>TOTAL</small><br>
                                            <strong>₹<%= data.totalAmount %></strong>
                                        </div>

                                        <div class="col-md-2">
                                            <small>ORDER STATUS</small><br>
                                            <span class="badge 
    <%= data.status === 'processing' ? 'bg-warning text-dark' :
        data.status === 'shipped' ? 'bg-primary' :
        data.status === 'delivered' ? 'bg-success' :
        data.status === 'cancelled' ? 'bg-danger' :
        data.status === 'returned' ? 'bg-dark' :
        'bg-secondary' %>">
                                                <%= data.status %>
                                            </span>
                                        </div>

                                        <div class="col-md-2">
                                            <small>PAYMENT STATUS</small><br>

                                            <% if (data.paymentStatus==="failed" ) { %>
                                                <a href="/retry-payment/<%= data._id %>" class="btn btn-danger btn-sm">
                                                    Retry Payment
                                                </a>
                                                <% } else { %>
                                                    <span class="badge 
            <%= data.paymentStatus === 'pending' ? 'bg-warning text-dark' :
                data.paymentStatus === 'paid' ? 'bg-success' :
                data.paymentStatus === 'refunded' ? 'bg-info text-dark' :
                'bg-secondary' %>">
                                                        <%= data.paymentStatus %>
                                                    </span>
                                                    <% } %>
                                        </div>

                                        <div class="col-md-2 text-end">
                                            <a href="/orders/<%= data._id %>" class="btn btn-primary btn-sm">View</a>

                                            <% if (data.status==="processing" ) { %>
                                                <button type="button" class="btn btn-danger btn-sm cancel-order-btn"
                                                    data-id="<%= data._id %>">
                                                    Cancel Order
                                                </button>
                                                <% } %>

                                        </div>
                                    </div>

                                    <hr>

                                    <!-- ORDER ITEMS -->
                                    <% orderItems .filter(item=> item.order_id.toString() === data._id.toString())
                                        .forEach(item => { %>

                                        <div class="d-flex justify-content-between align-items-center mb-3">

                                            <!-- LEFT SIDE -->
                                            <div class="d-flex align-items-center">

                                                <img src="<%= item.image %>" width="60" class="me-3 rounded">

                                                <div>
                                                    <strong>
                                                        <%= item.productName %>
                                                    </strong><br>
                                                    Qty: <%= item.quantity %><br>
                                                        Price: ₹<%= item.finalPrice %>
                                                </div>

                                            </div>

                                            <!-- RIGHT SIDE -->
                                            <div class="d-flex align-items-center gap-3">

                                                <!-- STATUS -->
                                                <span class="badge 
            <%= item.status === 'processing' ? 'bg-warning text-dark' :
                item.status === 'shipped' ? 'bg-primary' :
                item.status === 'delivered' ? 'bg-success' :
                item.status === 'cancelled' ? 'bg-danger' :
                item.status === 'returned' ? 'bg-dark' :
                'bg-secondary' %>">
                                                    <%= item.status %>
                                                </span>

                                                <!-- ACTION BUTTONS -->
                                                <% if (item.status==="processing" ) { %>
                                                    <button type="button"
                                                        class="btn btn-danger btn-sm cancel-product-btn"
                                                        data-id="<%= item._id %>">
                                                        Cancel
                                                    </button>
                                                    <% } else if (item.status==="delivered" ) { %>
                                                        <% if (!item.returnRequested && !item.returnAccepted &&
                                                            !item.returnRejected) { %>
                                                            <button type="button"
                                                                class="btn btn-outline-danger btn-sm return-product-btn"
                                                                data-id="<%= item._id %>">
                                                                Return
                                                            </button>
                                                            <% } else if(item.returnRequested && !item.returnAccepted &&
                                                                !item.returnRejected) { %>
                                                                <span class="badge bg-danger">
                                                                    Return Requested
                                                                </span>
                                                                <% } else if(item.returnAccepted) { %>
                                                                    <span class="badge bg-success">
                                                                        Return Accepted
                                                                    </span>
                                                                    <% } else if(item.returnRejected) { %>
                                                                        <span class="badge bg-danger">
                                                                            Return Rejected
                                                                        </span>
                                                                        <% } %>

                                                                            <% } %>

                                            </div>

                                        </div>
                                        <hr>

                                        <% }) %>

                                </div>
                            </div>

                            <% }) %>

                                <!-- PAGINATION -->
                                <nav>
                                    <ul class="pagination justify-content-center">

                                        <% if (currentPage> 1) { %>
                                            <li class="page-item">
                                                <a class="page-link" href="/orders?page=<%= currentPage - 1 %>">Prev</a>
                                            </li>
                                            <% } %>

                                                <% for (let i=1; i <=totalPages; i++) { %>
                                                    <li class="page-item <%= currentPage === i ? 'active' : '' %>">
                                                        <a class="page-link" href="/orders?page=<%= i %>">
                                                            <%= i %>
                                                        </a>
                                                    </li>
                                                    <% } %>

                                                        <% if (currentPage < totalPages) { %>
                                                            <li class="page-item">
                                                                <a class="page-link"
                                                                    href="/orders?page=<%= currentPage + 1 %>">Next</a>
                                                            </li>
                                                            <% } %>

                                    </ul>
                                </nav>

            </div>

    </div>

    <!-- Cancel Reason Modal -->
    <div class="modal fade" id="cancelModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title"></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <form id="cancelForm" method="POST">
                    <div class="modal-body">

                        <label for="reason" class="form-label">Select Reason</label>

                        <div class="form-check">
                            <select name="reasonSelect" id="reasonSelect" class="form-select">

                            </select>
                        </div>

                        <div id="otherReasonBox" class="mt-3" style="display: none;">
                            <label class="form-label">Please specify</label>
                            <input type="text" id="otherReasonInput" class="form-control"
                                placeholder="Enter your reason">
                        </div>

                        <input type="hidden" name="reason" id="finalReason">

                    </div>

                    <div class="modal-footer">
                        <button type="submit" class="btn btn-danger">Confirm Cancel</button>
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    </div>

                </form>

            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js">
    </script>


    <script>

        const message = "<%= message %>";
        const type = "<%= type %>";
        if (message) {
            Swal.fire({
                icon: type,
                text: message,
                confirmButtonColor: '#007bff',
                timer: 5000,
            });
        }

        const input = document.getElementById("searchInput");
        const clearBtn = document.getElementById("clearBtn");
        const form = document.getElementById("searchForm");

        function toggleClearBtn() {
            clearBtn.style.display = input.value ? "block" : "none";
        }

        input.addEventListener("input", toggleClearBtn);

        clearBtn.addEventListener("click", () => {
            input.value = "";
            clearBtn.style.display = "none";
            form.submit();
        });

        toggleClearBtn();

        const cancelOrderBtns = document.querySelectorAll(".cancel-order-btn");
        const cancelForm = document.getElementById("cancelForm");
        const cancelProductBtns = document.querySelectorAll(".cancel-product-btn");
        const returnProductBtns = document.querySelectorAll(".return-product-btn");

        const reasonSelect = document.getElementById("reasonSelect");
        const otherReasonBox = document.getElementById("otherReasonBox");
        const otherReasonInput = document.getElementById("otherReasonInput");
        const finalReason = document.getElementById("finalReason");

        const cancelReasons = [
            "Changed my mind",
            "Found better price",
            "Ordered by mistake",
            "Delivery taking too long",
            "Other"
        ];

        const returnReasons = [
            "Product defective",
            "Wrong item received",
            "Not as described",
            "Size/fit issue",
            "Other"
        ];

        function renderReasons(reasons) {
            reasonSelect.innerHTML = `<option value="" disabled selected>-- Choose reason --</option>`;

            reasons.forEach(reason => {
                const option = document.createElement("option");
                option.value = reason;
                option.textContent = reason;
                reasonSelect.appendChild(option);
            });
        }

        cancelOrderBtns.forEach(btn => {
            btn.addEventListener("click", function () {
                const order_id = btn.getAttribute("data-id");

                const modalTitle = document.querySelector("#cancelModal .modal-title");
                modalTitle.innerText = "Cancel Reason";

                renderReasons(cancelReasons);

                cancelForm.action = `/orders/cancel/${order_id}`;

                reasonSelect.value = "";
                otherReasonInput.value = "";
                finalReason.value = "";
                otherReasonBox.style.display = "none";

                const modal = document.getElementById("cancelModal");
                const modalInstance = new bootstrap.Modal(modal);
                modalInstance.show();
            });
        });

        cancelProductBtns.forEach(btn => {
            btn.addEventListener("click", function () {
                const itemId = btn.getAttribute("data-id");

                const modalTitle = document.querySelector("#cancelModal .modal-title");
                modalTitle.innerText = "Cancel Reason";

                renderReasons(cancelReasons);

                cancelForm.action = `/orders/item-cancel/${itemId}`;

                reasonSelect.value = "";
                otherReasonInput.value = "";
                finalReason.value = "";
                otherReasonBox.style.display = "none";

                const modal = document.getElementById("cancelModal");
                const modalInstance = new bootstrap.Modal(modal);
                modalInstance.show();
            });
        });

        returnProductBtns.forEach(btn => {
            btn.addEventListener("click", function () {
                const itemId = btn.getAttribute("data-id");

                const modalTitle = document.querySelector("#cancelModal .modal-title");
                modalTitle.innerText = "Return Reason";

                renderReasons(returnReasons);

                cancelForm.action = `/orders/item-return/${itemId}`;

                reasonSelect.value = "";
                otherReasonInput.value = "";
                finalReason.value = "";
                otherReasonBox.style.display = "none";

                const modal = document.getElementById("cancelModal");
                const modalInstance = new bootstrap.Modal(modal);
                modalInstance.show();
            });
        });

        reasonSelect.addEventListener("change", () => {
            if (reasonSelect.value === "Other") {
                otherReasonBox.style.display = "block";
            } else {
                otherReasonBox.style.display = "none";
                otherReasonInput.value = "";
            }
        });

        cancelForm.addEventListener("submit", (e) => {
            e.preventDefault();

            if (!reasonSelect.value) {
                Swal.fire({
                    icon: "warning",
                    text: "Please select the reason"
                });
                return;
            }

            if (reasonSelect.value === "Other") {
                if (otherReasonInput.value.trim() === "") {
                    Swal.fire({
                        icon: "warning",
                        text: "Please specify the reason"
                    });
                    return;
                }
                finalReason.value = otherReasonInput.value;
            } else {
                finalReason.value = reasonSelect.value;
            }

            Swal.fire({
                title: "Are you sure?",
                text: "Do you want to cancel this order?",
                icon: "warning",
                showCancelButton: true,
                confirmButtonText: "Yes, cancel it"
            }).then((result) => {
                if (result.isConfirmed) {
                    cancelForm.submit();
                }
            });
        })

    </script>