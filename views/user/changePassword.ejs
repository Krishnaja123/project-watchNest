<%- include("../partials/user/header", { title: "Change Password" , hideNavBar: true }) %>

    <link rel="stylesheet" href="/css/user/changePassword.css">


    <div class="main-content">

        <div class="form-card">

            <h2 class="card-title">Change Password</h2>
            <p class="card-subtitle">Update your account password</p>

            <form action="/profile/change-password" method="POST" id="change-password-form">

                <div class="form-group mb-3">
                    <label>Current Password</label>
                    <div class="position-relative">
                        <input type="password" name="currentPassword" id="current-pw"
                            placeholder="Enter current password" class="form-control pe-5">
                        <i class="fa fa-eye toggle-password" onclick="togglePassword('current-pw', this)"></i>
                    </div>
                    <div id="error2" class="error-message"></div>
                </div>

                <div class="form-group mb-3">
                    <label>New Password</label>
                    <div class="position-relative">
                        <input type="password" name="newPassword" placeholder="Enter new password" id="new-pw"
                            class="form-control pe-5">
                        <i class="fa fa-eye toggle-password" onclick="togglePassword('new-pw', this)"></i>
                    </div>
                    <div id="error3" class="error-message"></div>
                </div>

                <div class="form-group mb-3">
                    <label>Confirm Password</label>

                    <div class="position-relative">
                        <input type="password" name="confirmPassword" id="confirm-pw" placeholder="Confirm new password"
                            class="form-control pe-5">
                        <i class="fa fa-eye toggle-password" onclick="togglePassword('confirm-pw', this)"></i>
                    </div>
                    <div id="error4" class="error-message"></div>
                </div>

                <div class="buttons">
                    <button type="submit" class="btn-primary">
                        Verify & Send OTP
                    </button>
                </div>

            </form>

        </div>

    </div>

    <script>
        function togglePassword(inputId, icon) {
            const input = document.getElementById(inputId);

            if (input.type === "password") {
                input.type = "text";
                icon.classList.remove("fa-eye");
                icon.classList.add("fa-eye-slash");
            } else {
                input.type = "password";
                icon.classList.remove("fa-eye-slash");
                icon.classList.add("fa-eye");
            }
        }

        document.addEventListener('DOMContentLoaded', function () {

            const message = "<%= message || '' %>";
            const type = "<%= type || 'info' %>";

            if (message && message.trim() !== "") {
                Swal.fire({
                    icon: type,
                    text: message,
                    confirmButtonColor: '#007bff',
                    timer: 3000
                });
            }
            const form = document.getElementById('change-password-form');
            const currentPasswordInput = document.getElementById('current-pw');
            const currentPasswordError = document.getElementById('error2');
            const newPasswordInput = document.getElementById('new-pw');
            const newPasswordError = document.getElementById('error3');
            const confirmPasswordInput = document.getElementById('confirm-pw');
            const confirmPasswordError = document.getElementById('error4');

            form.addEventListener('submit', function (event) {
                event.preventDefault();

                const isCurrentPasswordValid = validateCurrentPassword();
                const isNewPasswordValid = validateNewPassword();
                const isConfirmPassword = validateConfirmPassword();


                if (isCurrentPasswordValid && isNewPasswordValid && isConfirmPassword) {
                    form.submit();
                }

            });


            function validateCurrentPassword() {
                const password = currentPasswordInput.value.trim();
                if (password.length === 0) {
                    currentPasswordError.textContent = 'Please enter password';
                    return false;
                } else if (password.length < 8) {
                    currentPasswordError.textContent = 'Password length must be minimum 8 characters';
                    return false;
                } else {
                    currentPasswordError.textContent = "";
                    return true;
                }
            }


            function validateNewPassword() {
                const password = newPasswordInput.value;
                const passwordRegex = /^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[@$!%*?&])[A-Za-z\d@$!%*?&]{8,}$/;
                if (!passwordRegex.test(password)) {
                    newPasswordError.textContent = 'Password must be at least 8 characters long and include at least one uppercase letter, one lowercase letter, one number, and one special character (@$!%*?&).';
                    return false;
                }
                newPasswordError.textContent = '';
                return true;
            }

            function validateConfirmPassword() {
                const password = newPasswordInput.value;
                const confirm = confirmPasswordInput.value;
                if (password !== confirm) {
                    confirmPasswordError.textContent = 'Passwords do not match'; return false;
                }
                confirmPasswordError.textContent = '';
                return true;
            }

        })

    </script>

    <%- include("../partials/user/footer") %>