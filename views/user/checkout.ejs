<%- include("../partials/user/header", { title: "checkout Page" , hideNavBar: true }) %>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        body {
            background: #f4f5f7;
        }

        /* Layout */
        .checkout-container {
            max-width: 1200px;
            margin: 50px auto;
        }

        /* Card (same as profile page) */
        .card-custom {
            background: #ffffff;
            border-radius: 18px;
            padding: 25px;
            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.06);
            transition: 0.3s ease;
        }

        .card-custom:hover {
            transform: translateY(-4px);
        }

        /* Section Title */
        .card-custom h5 {
            font-weight: 600;
            margin-bottom: 20px;
        }

        /* Address Card */
        .address-card {
            border: 1px solid #eee;
            border-radius: 12px;
            padding: 18px;
            margin-bottom: 18px;
            background: #fafafa;
            transition: 0.3s ease;
        }

        .address-card:hover {
            background: #ffffff;
            box-shadow: 0 6px 18px rgba(0, 0, 0, 0.05);
        }

        /* Radio spacing */
        .address-card input[type="radio"] {
            margin-right: 10px;
        }

        /* Add Address Button (Gold Theme) */
        .btn-add-address {
            background: linear-gradient(135deg, #c8a27c, #a77b4e);
            color: #fff;
            padding: 8px 18px;
            border-radius: 25px;
            font-size: 13px;
            font-weight: 500;
            text-decoration: none;
            transition: 0.3s ease;
            border: none;
        }

        .btn-add-address:hover {
            opacity: 0.9;
            color: #fff;
            transform: translateY(-2px);
        }

        /* Edit Button (Outline Gold) */
        .btn-edit {
            padding: 6px 16px;
            border-radius: 20px;
            border: 1px solid #c8a27c;
            background: transparent;
            color: #c8a27c;
            font-size: 14px;
            transition: 0.3s ease;
        }

        .btn-edit:hover {
            background: #c8a27c;
            color: #fff;
        }

        /* Order Summary Items */
        .summary-item {
            display: flex;
            justify-content: space-between;
            margin-bottom: 10px;
            font-size: 15px;
        }

        /* Coupon input */
        .input-group input {
            border-radius: 10px 0 0 10px;
        }

        .input-group .btn {
            border-radius: 0 10px 10px 0;
        }

        /* Place Order Button (Same as profile save button) */
        .place-order-btn {
            width: 100%;
            padding: 14px;
            border-radius: 30px;
            background: linear-gradient(135deg, #c8a27c, #a77b4e);
            border: none;
            color: white;
            font-weight: 500;
            transition: 0.3s ease;
        }

        .place-order-btn:hover {
            opacity: 0.9;
        }

        /* Responsive */
        @media (max-width: 992px) {
            .checkout-container {
                padding: 20px;
            }
        }
    </style>

    <div class="container checkout-container">
        <div class="row">

            <!-- LEFT SIDE - ADDRESS -->
            <div class="col-md-7">
                <div class="card-custom">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5>Shipping Address</h5>
                        <div class="address-add-btn">
                            <a href="/address?from=checkout" class="btn-add-address">
                                + Add New Address
                            </a>
                        </div>
                    </div>
                    <form action="/order/placeOrder" method="POST">

                        <input type="hidden" name="discount" id="discountInput" value="0">

                        <% if(addresses && addresses.length> 0){ %>
                            <% addresses.forEach(address=> { %>
                                <div class="address-card">
                                    <label>
                                        <input type="radio" name="selectedAddressId" value="<%= address._id %>"
                                            <%=address.is_default ? 'checked' : '' %> >
                                        <strong>
                                            <%= address.name %>
                                        </strong><br>
                                        <%= address.city %>, <%= address.district %><br>
                                                <%= address.state %><br>
                                                    Pin: <%= address.pincode %><br>
                                                        Ph: <%= address.phone %>
                                    </label>
                                </div>
                                <% }) %>
                                    <% } else { %>
                                        <p>No address found.</p>
                                        <% } %>
                </div>
            </div>


            <!-- RIGHT SIDE - ORDER SUMMARY -->
            <div class="col-md-5">
                <div class="card-custom">

                    <h5 class="mb-3">Your Order</h5>

                    <% let subtotal=0; %>
                        <% cartItems.forEach(item=> {
                            const price = item.discountedPrice || item.price;
                            const variant = item.product_id.variants.find(v =>
                            v._id.toString() === item.variant_id.toString());
                            %>
                            <div class="d-flex align-items-center mb-3">
                                <img src="<%= variant.images[0] %>" width="60" class="me-3 rounded">
                                <div class="flex-grow-1">
                                    <strong>
                                        <%= item.product_id.name %>
                                    </strong><br>
                                    Qty: <%= item.quantity %>
                                </div>
                                <div>₹<%= price * item.quantity %>
                                </div>
                            </div>
                            <% }) %>

                                <!-- Coupon -->
                                <div class="mb-3">
                                    <label>Apply Coupon</label><br>

                                    <div class="input-group">
                                        <input type="text" id="couponInput" name="couponCode" class="form-control"
                                            placeholder="Enter coupon code">
                                        <button type="button" onclick="applyCoupon()" class="btn btn-outline-secondary">
                                            APPLY
                                        </button>
                                    </div>

                                    <a href="/coupons/?cartTotal=<%= subTotal %>"
                                        class="place-order-btn mt-4 text-center d-block" style="text-decoration: none;">
                                        VIEW COUPONS
                                    </a>
                                </div>

                                <hr>
                                <div class="summary-item">
                                    <span>Subtotal</span>
                                    <span>₹<%= subTotal %></span>
                                </div>

                                <div class="summary-item text-success">
                                    <span>Coupon Discount</span>
                                    <span id="discountAmount">- ₹0</span>
                                </div>

                                <div class="summary-item fw-bold">
                                    <span>Total</span>
                                    <span id="finalTotal">₹<%= subTotal %></span>
                                </div>

                                <!-- Payment Method -->
                                <h6 class="mb-2">Payment Method</h6>

                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="paymentMethod" value="online">
                                    <label class="form-check-label">Online Payment</label>
                                </div>

                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="paymentMethod" value="wallet">
                                    <label class="form-check-label">Wallet Payment</label>
                                </div>

                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="paymentMethod" value="cod"
                                        checked>
                                    <label class="form-check-label">Cash on Delivery</label>
                                </div>

                                <button type="button" onclick="handlePlaceOrder()" class="place-order-btn mt-4">
                                    PLACE ORDER
                                </button>
                                </form>
                </div>
            </div>

        </div>
    </div>

    <%- include("../partials/user/footer") %>

        <script src="https://checkout.razorpay.com/v1/checkout.js"></script>

        <script>

            document.addEventListener("DOMContentLoaded", function () {
                const message = '<%= message %>';
                const type = '<%= type %>';

                if (message && message.trim() !== '') {
                    Swal.fire({ icon: type, text: message, confirmButtonColor: '#007bff' });
                }
            });


            async function handlePlaceOrder() {

                const couponCode = document.getElementById("couponInput").value.trim() || null;
                
                const paymentMethod = document.querySelector('input[name="paymentMethod"]:checked').value;

                if (paymentMethod === "cod") {
                    document.querySelector('form[action="/order/placeOrder"]').submit();
                    return;
                }

                if (paymentMethod === "online") {
                    const couponCode = document.getElementById("couponInput").value.trim() || null;

                    //const totalAmount = <%= subTotal %>;
                    const totalAmount = finalAmount;
                    const selectedAddressBtn = document.querySelector('input[name="selectedAddressId"]:checked');

                    if (!selectedAddressBtn) {
                        Swal.fire({
                            icon: "error",
                            text: "Please select a shipping address",
                            confirmButtonColor: '#007bff'
                        });
                        return;
                    }

                    const selectedAddressId = selectedAddressBtn.value;

                    const response = await fetch("/payment/create-order", {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json"
                        },
                        body: JSON.stringify({
                            amount: totalAmount,
                            selectedAddressId,
                            couponCode,
                            discount: appliedDiscount
                        })
                    });

                    const order = await response.json();
                    console.log("order: ", order);

                    openRazorpay(order);
                }

            }

            // order = {
            //     razorpayOrderId: razorpayOrder.id,
            //             amount: razorpayOrder.amount,
            //             orderId: order.orderId,
            //             order_id: order._id
            // }            


            function openRazorpay(order) {

                var options = {
                    key: "<%= razorpayKey %>",
                    amount: order.amount,
                    currency: "INR",
                    name: "Watch Nest",
                    order_id: order.razorpayOrderId,

                    handler: async function (response) {

                        const verify = await fetch("/payment/verify-payment", {
                            method: "POST",
                            headers: {
                                "Content-Type": "application/json"
                            },
                            body: JSON.stringify({
                                ...response,
                                orderId: order.order_id,
                            })
                        });

                        const result = await verify.json();
                        console.log("result: ", result);

                        if (result.status) {
                            window.location.href = `/order/success/${result.orderId}`;
                        } else {
                            alert("Payment verification failed");
                        }

                    },

                    modal: {
                        ondismiss: async function () {

                            await fetch("/payment-failed", {
                                method: "POST",
                                headers: {
                                    "Content-Type": "application/json"
                                },
                                body: JSON.stringify({
                                    orderId: order.order_id
                                })
                            });

                            window.location.href = `/payment-failed/${order.orderId}`;
                        }
                    }
                };

                var rzp = new Razorpay(options);

                rzp.on("payment.failed", async function (response) {

                    await fetch("/payment-failed", {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json"
                        },
                        body: JSON.stringify({
                            orderId: order.order_id
                        })
                    });

                    window.location.href = `/payment-failed/${order.orderId}`;

                });
                rzp.open();
            }

            let appliedDiscount = 0;
            let finalAmount = <%= subTotal %>;

            async function applyCoupon() {
                const code = document.getElementById("couponInput").value.trim();

                if (!code) {
                    Swal.fire({
                        icon: "warning",
                        text: "Enter a coupon code",
                        timer: 1500,
                        showConfirmButton: false
                    });
                    return;
                }

                try {
                    const response = await fetch("/apply-coupon", {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json"
                        },
                        body: JSON.stringify({ code })
                    });

                    const result = await response.json();

                    if (result.success) {

                        appliedDiscount = result.discount;
                        finalAmount = result.finalTotal;

                        document.getElementById("discountAmount").innerText = `- ₹${result.discount}`;
                        document.getElementById("finalTotal").innerText = `₹${result.finalTotal}`;

                        document.getElementById("discountInput").value = appliedDiscount;

                        document.getElementById("couponInput").disabled = true;

                        Swal.fire({
                            icon: "success",
                            text: "Coupon Applied!",
                            timer: 1500,
                            showConfirmButton: false
                        });

                    } else {
                        Swal.fire({
                            icon: "error",
                            text: result.message,
                            timer: 1500,
                            showConfirmButton: false
                        });
                    }

                } catch (err) {
                    console.error(err);
                    Swal.fire({
                        icon: "error",
                        text: "Error applying coupon",
                        timer: 1500,
                        showConfirmButton: false
                    });
                }
            }

        </script>