<%- include("../partials/user/header", { title: product.name }) %>

    <head>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
        <style>
            body {
                background: #f5f5f5;
                /* soft premium background */
            }


            .product-detail-card {
                background: #fff;
                border-radius: 20px;
                box-shadow: 0 15px 35px rgba(0, 0, 0, 0.05);
            }

            #name {
                font-weight: 700;
                font-size: 28px;
                color: #111;
            }

            #price {
                color: #c5a253;
                /* luxury gold */
                font-size: 28px;
            }

            .btn-primary-custom {
                background: #111;
                color: #fff;
                border-radius: 30px;
                padding: 10px 30px;
                border: none;
                transition: 0.3s;
            }

            .btn-primary-custom:hover {
                background: #c5a253;
                transform: translateY(-2px);
            }

            .btn-outline-custom {
                border: 1px solid #111;
                color: #111;
                border-radius: 30px;
                padding: 10px 30px;
                background: transparent;
                transition: 0.3s;
            }

            .btn-outline-custom:hover {
                background: #111;
                color: #fff;
            }

            .thumb-img {
                width: 70px;
                height: 70px;
                object-fit: cover;
                border: 1px solid #ddd;
                margin-bottom: 10px;
                cursor: pointer;
                border-radius: 6px;
            }

            .thumb-img.active {
                border: 2px solid #000;
            }

            .main-image-wrapper {
                width: 100%;
                height: 420px;
                display: flex;
                align-items: center;
                justify-content: center;
                border: 1px solid #eee;
                border-radius: 10px;
                background: #fafafa;
            }

            .main-img {
                max-width: 100%;
                max-height: 100%;
                object-fit: contain;
            }

            .variant-img {
                width: 45px;
                height: 45px;
                object-fit: cover;
                border-radius: 6px;
            }

            .variant-btn {
                border: 1px solid #ccc;
                padding: 4px 4px;
                margin-right: 10px;
                margin-top: 10px;
                border-radius: 8px;
                background: #fff;
                cursor: pointer;
                text-align: left;
                font-size: 14px;
            }

            .variant-btn.active {
                border-color: #000;
                font-weight: 600;
                background: #f8f8f8;
            }

            .variant-btn:hover {
                border-color: var(--accent-gold);
                transform: translateY(-2px);
            }

            .main-image-wrapper {
                position: relative;
                overflow: hidden;
                /* VERY IMPORTANT */
                cursor: zoom-in;
            }

            .main-img {
                transition: transform 0.4s ease;
            }

            .main-image-wrapper:hover .main-img {
                transform: scale(1.6);
            }

            .similar-card {
                border-radius: 10px;
                height: 100%;
            }

            .similar-img {
                width: 100%;
                height: 120px;
                object-fit: contain;
                padding: 12px;
            }

            @media (min-width: 768px) {
                .similar-img {
                    height: 140px;
                }
            }

            @media (min-width: 1200px) {
                .similar-img {
                    height: 160px;
                }
            }

            .similar-card,
            .card {
                border-radius: 16px;
                transition: all 0.3s ease;
                border: 1px solid var(--border-light);
            }

            .card:hover {
                transform: translateY(-6px);
                box-shadow: 0 12px 25px rgba(0, 0, 0, 0.08);
            }

            .breadcrumb {
                background: transparent;
                font-weight: 500;
            }

            .breadcrumb-item.active {
                color: #c5a253;
            }

            .card-body p {
                color: var(--accent-gold);
            }

            .add-cart-btn {
                margin-top: 15px;
                padding: 10px 20px;
                border: none;
                border-radius: 25px;
                background: #d8a708;
                color: #fff;
                font-size: 14px;
                cursor: pointer;
                transition: 0.3s ease;
                opacity: 1;
            }


            .add-cart-btn:disabled {
                background-color: #ccc;
                color: #666;
                cursor: not-allowed;
                opacity: 0.6;
            }

            .price-box {
                margin: 20px 0;
            }

            .price-row {
                display: flex;
                align-items: center;
                gap: 12px;
                flex-wrap: wrap;
            }

            .final-price {
                font-size: 30px;
                font-weight: 700;
                color: #111;
            }

            .original-price {
                font-size: 16px;
                text-decoration: line-through;
                color: #999;
            }

            .discount-badge {
                background: linear-gradient(135deg, #28a745, #218838);
                color: #fff;
                font-size: 13px;
                font-weight: 600;
                padding: 5px 12px;
                border-radius: 20px;
            }

            .save-text {
                font-size: 14px;
                color: #28a745;
                margin-top: 4px;
                font-weight: 500;
            }

            #descText {
                display: -webkit-box;
                -webkit-line-clamp: 3;
                -webkit-box-orient: vertical;
                overflow: hidden;
            }

            #descText.expanded {
                -webkit-line-clamp: unset;
                overflow: visible;
            }

            .wishlist {
                width: 42px;
                height: 42px;
                min-width: 42px;
                border: 1px solid #ddd;
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                cursor: pointer;
                transition: all 0.3s ease;
                background: #fff;
            }

            .wishlist:hover {
                transform: scale(1.08);
            }

            .wishlist i {
                font-size: 20px;
                color: #aaa;
            }

            .wishlist i.active {
                color: #e63946;
            }
        </style>

    </head>

    <body>
        <div class="container my-5">
            <div class="product-detail-card p-4">
                <!-- Breadcrumb -->
                <nav aria-label="breadcrumb" class="mb-4">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a href="/home">Home</a></li>
                        <li class="breadcrumb-item"><a href="/products">Shop</a></li>
                        <li class="breadcrumb-item active" aria-current="page">
                            <%= product.name %>
                        </li>
                    </ol>
                </nav>

                <div class="row">

                    <!-- LEFT IMAGE + VARIANTS -->
                    <div class="col-md-6">

                        <div class="d-flex gap-3">

                            <!-- THUMBNAILS -->
                            <div class="d-flex flex-column align-items-center thumbnail-container">
                                <% defaultVariant.images.forEach((img, index)=> { %>
                                    <img src="<%= img %>" class="thumb-img <%= index === 0 ? 'active' : '' %>"
                                        onclick="changeImage('<%= img %>', this)" />
                                    <% }) %>
                            </div>

                            <!-- MAIN IMAGE -->
                            <div class="main-image-wrapper">
                                <img id="mainImage" src="<%= defaultVariant.images[0] %>" class="main-img" />
                            </div>
                        </div>

                        <!-- VARIANTS -->
                        <div class="mt-4">
                            <h6 class="fw-bold">Available Variants</h6>

                            <% viewedVariants.forEach((variant, index)=> { %>
                                <button
                                    class="variant-btn <%= variant._id.toString() === defaultVariant._id.toString() ? 'active' : '' %>"
                                    data-index="<%= index %>" onclick="changeVariant(this)">
                                    <img src="<%= variant.images[0] %>" class="variant-img">

                                </button>
                                <% }) %>
                        </div>

                    </div>

                    <!-- RIGHT PRODUCT DETAILS -->
                    <div class="col-md-6 ps-md-5">

                        <!-- <h2 class="fw-bold" id="name">
                            <%= `${product.name} with ${defaultVariant.dial_color} dial and
                                ${defaultVariant.strap_color} strap` %>
                        </h2> -->

                        <div class="d-flex align-items-start justify-content-between mb-2">

                            <h2 class="fw-bold mb-0" id="name">
                                <%= `${product.name} with ${defaultVariant.dial_color} dial and
                                    ${defaultVariant.strap_color} strap` %>
                            </h2>

                            <div class="wishlist" data-product-id="<%= product._id %>"
                                data-variant-id="<%= defaultVariant._id %>">

                                <i
                                    class="fa fa-heart <%= (wishlistVariantIds || []).includes(defaultVariant._id.toString()) ? 'active' : '' %>"></i>

                            </div>

                        </div>

                        <p class="text-muted" id="review">
                            ⭐ <%= product.reviews_count %> reviews
                        </p>

                        <div class="price-box">
                            <div class="price-row">
                                <span class="final-price">
                                    ₹ <%= defaultVariant.finalPrice ?? defaultVariant.price %>
                                </span>

                                <% if (defaultVariant.discountAmount> 0) { %>
                                    <span class="original-price">
                                        ₹ <%= defaultVariant.price %>
                                    </span>
                                    <% } %>
                            </div>
                        </div>

                        <p id="stockStatus"></p>
                        <p class="text-muted">
                            <strong>Category:</strong>
                            <% if (product.cat_id) { %>
                                <%= product.cat_id.name %>
                                    <% } else { %>
                                        ""
                                        <% } %>
                        </p>

                        <p class="text-muted">
                            <strong>Brand:</strong>
                            <%= product.brand_id?.name %>
                        </p>

                        <p class="text-muted" id="strap_color">
                            <strong>Strap color:</strong>
                            <%= defaultVariant.strap_color %>
                        </p>

                        <p class="text-muted" id="dial_color">
                            <strong>Dial color:</strong>
                            <%= defaultVariant.dial_color %>
                        </p>

                        <p class="mt-3" id="descText">
                            <%= product.descrip || "No description available" %>
                        </p>

                        <% if (product.descrip && product.descrip.length> 120) { %>
                            <a href="javascript:void(0)" id="readMoreBtn" onclick="toggleReadMore()"
                                style="color:#c5a253;">
                                Read more
                            </a>
                            <% } %>

                                <div class="mt-4 d-flex gap-3" id="actionButtons">
                                    <button type="button" id="buyNowBtn" class="add-cart-btn" <%=defaultVariant.stock
                                        <=0 ? 'disabled style="opacity:0.5; cursor:not-allowed;"' : '' %>>
                                        Buy Now
                                    </button>

                                    <button type="button" id="addToCartBtn" class="add-cart-btn"
                                        data-product-id="<%= product._id %>" data-variant-id="<%= defaultVariant._id %>"
                                        <%=defaultVariant.stock <=0
                                        ? 'disabled style="opacity:0.5; cursor:not-allowed;"' : '' %>>
                                        Add To Cart
                                    </button>
                                </div>

                    </div>
                </div>
            </div>
        </div>

        <!-- SIMILAR PRODUCTS -->
        <div class="container my-5">
            <h4 class="fw-bold mb-4 text-center">You May Also Like</h4>

            <div class="row g-4">
                <% similarProducts.forEach(item=> { %>
                    <div class="col-6 col-md-4 col-lg-3">
                        <a href="/product/<%= item._id %>/<%= item.variants[0]?._id %>"
                            class="text-decoration-none text-dark">

                            <div class="card similar-card h-100 p-3">

                                <div class="text-center mb-3">
                                    <% if (item.variants[0]?.stock===0) { %>
                                        <div class="out-of-stock-label">Out of Stock</div>
                                        <% } %>
                                            <% if (item.variants[0]?.view===false) { %>
                                                <div class="out-of-stock-label">Not Available</div>
                                                <% } %>
                                                    <img src="<%= item.variants[0].images[0] %>" alt="<%= item.name %>"
                                                        class="similar-img">
                                </div>

                                <div class="card-body text-center p-2">
                                    <h6 class="fw-semibold" style="min-height: 45px;">
                                        <%= item.name.length> 40
                                            ? item.name.substring(0, 40) + "..."
                                            : item.name %>
                                    </h6>

                                    <p class="fw-bold mt-2" style="color:#c5a253;">
                                        ₹ <%= item.variants[0].price %>
                                    </p>

                                    <button class="btn-outline-custom w-100 mt-2">
                                        View Product
                                    </button>
                                </div>

                            </div>

                        </a>
                    </div>
                    <% }) %>
            </div>
        </div>
        <%- include("../partials/user/footer") %>

            <script>

                updateStock(<%= defaultVariant.stock %>);

                const allVariants = <%- JSON.stringify(updatedVariants) %>;

                function changeVariant(button) {
                    const index = button.dataset.index;
                    const variant = allVariants[index];

                    updateUI(variant);

                    document.querySelectorAll('.variant-btn')
                        .forEach(btn => btn.classList.remove('active'));

                    button.classList.add('active');

                }

                function changeImage(src, element) {
                    document.getElementById("mainImage").src = src;

                    document.querySelectorAll(".thumb-img").forEach(img => {
                        img.classList.remove("active");
                    });

                    element.classList.add("active");
                }

                function updateStock(stock) {
                    const stockElement = document.getElementById("stockStatus");

                    if (stock > 5) {
                        stockElement.innerHTML = `In Stock (${stock} Available)`;
                        stockElement.style.color = "green";
                    } else if (stock > 0) {
                        stockElement.innerHTML = `Only ${stock} left`;
                        stockElement.style.color = "orange";
                    } else {
                        stockElement.innerHTML = "Out of Stock";
                        stockElement.style.color = "red";
                    }
                }
                updateUI(<%- JSON.stringify(defaultVariant) %>);
                function updateUI(variant) {
                    document.getElementById('name').innerText =
                        `<%= product.name %> with ${variant.dial_color} dial and ${variant.strap_color} strap`;

                    const priceBox = document.querySelector(".price-box");

                    if (variant.discountAmount > 0) {
                        priceBox.innerHTML = `
            <div class="price-row">
                <span class="final-price">₹ ${Math.round(variant.finalPrice)}</span>
                <span class="original-price">₹ ${variant.price}</span>
                <span class="discount-badge">${Math.round((variant.discountAmount / variant.price) * 100)}% OFF</span>
            </div>
            <div class="save-text">
                You save ₹ ${Math.round(variant.discountAmount)}
            </div>
        `;
                    } else {
                        priceBox.innerHTML = `
            <div class="price-row">
                <span class="final-price">₹ ${variant.price}</span>
            </div>
        `;
                    }

                    document.getElementById('strap_color').innerHTML =
                        `<strong>Strap color:</strong> ${variant.strap_color}`;

                    document.getElementById('dial_color').innerHTML =
                        `<strong>Dial color:</strong> ${variant.dial_color}`;

                    updateStock(variant.stock);

                    const addBtn = document.getElementById("addToCartBtn");
                    const buyBtn = document.getElementById("buyNowBtn");

                    addBtn.disabled = variant.stock <= 0;
                    buyBtn.disabled = variant.stock <= 0;

                    addBtn.dataset.variantId = variant._id;

                    const wishlistBtn = document.querySelector(".wishlist");
                    wishlistBtn.dataset.variantId = variant._id;

                    const wishlistVariantIds = <%- JSON.stringify(wishlistVariantIds || []) %>;

                    const heart = document.querySelector(".wishlist i");

                    if (wishlistVariantIds.includes(variant._id.toString())) {
                        heart.classList.add("active");
                    } else {
                        heart.classList.remove("active");
                    }

                    document.getElementById("mainImage").src = variant.images[0];

                    updateThumbnails(variant.images);

                    history.replaceState(null, "", `/product/${"<%= product._id %>"}/${variant._id}`);
                }

                function updateThumbnails(images) {

                    const thumbContainer = document.querySelector(".thumbnail-container");
                    thumbContainer.innerHTML = "";

                    images.forEach((img, index) => {
                        const image = document.createElement("img");
                        image.src = img;
                        image.className = "thumb-img" + (index === 0 ? " active" : "");
                        image.onclick = function () {
                            document.getElementById("mainImage").src = img;
                        };
                        thumbContainer.appendChild(image);
                    });
                }

                document.querySelectorAll(".add-cart-btn").forEach(button => {
                    button.addEventListener("click", async function () {
                        console.log("hi");

                        const variantId = this.dataset.variantId;
                        const productId = this.dataset.productId;
                        console.log("productId: ", productId);
                        console.log("variantId: ", variantId);

                        const response = await fetch("/cart/add", {
                            method: "POST",
                            headers: { "Content-Type": "application/json" },
                            body: JSON.stringify({ variantId, productId })
                        });

                        const result = await response.json();

                        if (result.success) {

                            Swal.fire({
                                title: "Added to Cart",
                                text: result.message,
                                icon: "success",
                                timer: 1500,
                                showConfirmButton: false
                            }).then(() => {
                                location.reload();
                            });

                        } else {

                            Swal.fire({
                                title: "Error!",
                                text: result.message,
                                icon: "error",
                                timer: 2000,
                                showConfirmButton: false
                            });

                        }

                    })
                })

                const wishlist = document.querySelector(".wishlist");
                wishlist.addEventListener("click", async function () {
                    try {
                        console.log("clicked");

                        const productId = this.dataset.productId;
                        const variantId = this.dataset.variantId;

                        const response = await fetch("/toggle-wishlist", {
                            method: "POST",
                            headers: {
                                "Content-Type": "application/json"
                            },
                            body: JSON.stringify({
                                productId,
                                variantId
                            })
                        });

                        const result = await response.json();

                        console.log("result:", result);

                        const heart = this.querySelector("i");

                        if (result.added) {
                            heart.classList.add("active");

                            Swal.fire({
                                icon: "success",
                                title: "Added to wishlist",
                                timer: 1500,
                                showConfirmButton: false
                            }).then(() => {
                                location.reload();
                            });

                        } else {
                            heart.classList.remove("active");

                            Swal.fire({
                                icon: "success",
                                title: "Added to wishlist",
                                timer: 1500,
                                showConfirmButton: false
                            }).then(() => {
                                location.reload();
                            });
                        }


                    } catch (error) {
                        console.error(error);

                        Swal.fire({
                            icon: "error",
                            title: "Something went wrong",
                            timer: 1500,
                            showConfirmButton: false
                        });
                    }
                });

                function toggleReadMore() {
                    const text = document.getElementById("descText");
                    const btn = document.getElementById("readMoreBtn");

                    text.classList.toggle("expanded");

                    if (text.classList.contains("expanded")) {
                        btn.innerText = "Read less";
                    } else {
                        btn.innerText = "Read more";
                    }
                }


            </script>
    </body>

    </html