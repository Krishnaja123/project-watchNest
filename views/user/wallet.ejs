<%- include("../partials/user/header", { title: "My Wallet" , hideNavBar: true }) %>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/user/profile.css">
    <link rel="stylesheet" href="/css/user/userSidebar.css">

    <!-- Breadcrumb -->
    <div class="container mt-3">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item">
                    <a href="/home">Home</a>
                </li>
                <li class="breadcrumb-item active" aria-current="page">
                    My Wallet
                </li>
            </ol>
        </nav>
    </div>

    <div class="profile-layout">
        <%- include("../partials/user/userSidebar") %>

            <div class="profile-main">

                <h1 class="main-title">My Wallet</h1>

                <div class="profile-grid">

                    <!-- LEFT CARD - WALLET BALANCE -->
                    <div class="card">

                        <div class="card-header">
                            <h2>Wallet Balance</h2>
                        </div>

                        <div class="card-body text-center">

                            <h3 class="text-success fw-bold">
                                ₹ <%= wallet?.balance?.toFixed(2) || "0.00" %>
                            </h3>

                            <p class="text-muted">Available Balance</p>

                        </div>
                    </div>

                    <!-- RIGHT CARD - TRANSACTIONS -->
                    <div class="card">

                        <div class="card-header">
                            <h2>Recent Transactions</h2>
                        </div>

                        <div class="card-body">

                            <% if (transactions && transactions.length> 0) { %>

                                <div class="table-responsive">
                                    <table class="table table-hover align-middle">
                                        <thead>
                                            <tr>
                                                <th>Date</th>
                                                <th>Type</th>
                                                <th>Amount</th>
                                                <th>Reason</th>
                                            </tr>
                                        </thead>

                                        <tbody>
                                            <% transactions.forEach(txn=> { %>
                                                <tr>
                                                    <td>
                                                        <%= new Date(txn.createdAt).toLocaleDateString() %>
                                                    </td>

                                                    <td>
                                                        <% if (txn.type==='credit' ) { %>
                                                            <span class="badge bg-success">Credit</span>
                                                            <% } else { %>
                                                                <span class="badge bg-danger">Debit</span>
                                                                <% } %>
                                                    </td>

                                                    <td>
                                                        <% if (txn.type==='credit' ) { %>
                                                            <span class="text-success fw-semibold">
                                                                + ₹<%= txn.amount %>
                                                            </span>
                                                            <% } else { %>
                                                                <span class="text-danger fw-semibold">
                                                                    - ₹<%= txn.amount %>
                                                                </span>
                                                                <% } %>
                                                    </td>

                                                    <td>
                                                        <%= txn.reason || "—" %>
                                                    </td>
                                                </tr>
                                                <% }) %>
                                        </tbody>

                                    </table>
                                </div>

                                <% } else { %>

                                    <div class="alert-box">
                                        No transactions found.
                                    </div>

                                    <% } %>

                        </div>
                    </div>

                </div>
                <% if (totalPages> 1) { %>
                    <nav class="mt-3">
                        <ul class="pagination justify-content-center">

                            <!-- Previous -->
                            <li class="page-item <%= currentPage === 1 ? 'disabled' : '' %>">
                                <a class="page-link" href="?page=<%= currentPage - 1 %>">
                                    Previous
                                </a>
                            </li>

                            <% for (let i=1; i <=totalPages; i++) { %>
                                <li class="page-item <%= currentPage === i ? 'active' : '' %>">
                                    <a class="page-link" href="?page=<%= i %>">
                                        <%= i %>
                                    </a>
                                </li>
                                <% } %>

                                    <li class="page-item <%= currentPage === totalPages ? 'disabled' : '' %>">
                                        <a class="page-link" href="?page=<%= currentPage + 1 %>">
                                            Next
                                        </a>
                                    </li>

                        </ul>
                    </nav>
                    <% } %>

            </div>
    </div>


    <script>
        const message = "<%= message %>";
        const type = "<%= type %>";

        if (message) {
            Swal.fire({
                title: type,
                icon: type,
                text: message,
                confirmButtonColor: '#007bff',
                timer: 2000,
                timerProgressBar: true,
                showConfirmButton: true
            });
        }
    </script>