<%- include("../partials/user/header", { title: "Order Details" , hideNavBar: true }) %>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/user/profile.css">
    <link rel="stylesheet" href="/css/user/userSidebar.css">

    <style>
        .status-wrapper {
            margin-bottom: 25px;
        }

        .progress {
            height: 8px;
            border-radius: 20px;
        }

        .status-step {
            text-align: center;
            flex: 1;
            position: relative;
        }

        .status-step:not(:last-child)::after {
            content: '';
            position: absolute;
            top: 10px;
            right: -50%;
            width: 100%;
            height: 2px;
            background: #ddd;
            z-index: 0;
        }

        .status-circle {
            width: 18px;
            height: 18px;
            border-radius: 50%;
            margin: 0 auto;
            background: #ccc;
            position: relative;
            z-index: 1;
        }

        .status-active {
            background: #28a745 !important;
        }
    </style>

    <!-- Breadcrumb -->
    <div class="container mt-3">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item">
                    <a href="/home">Home</a>
                </li>
                <li class="breadcrumb-item">
                    <a href="/orders">Your Orders</a>
                </li>
                <li class="breadcrumb-item active">
                    Order Details
                </li>
            </ol>
        </nav>
    </div>

    <div class="profile-layout">

        <%- include("../partials/user/userSidebar") %>

            <div class="profile-main">

                <h1 class="main-title">Order Details</h1>

                <% const status=order.status; let progress=0; if (status==="pending" ) progress=25; else if
                    (status==="confirmed" ) progress=50; else if (status==="shipped" ) progress=75; else if
                    (status==="delivered" ) progress=100; %>

                    <!-- STATUS PROGRESS BAR -->
                    <div class="status-wrapper">
                        <div class="progress mb-3">
                            <div class="progress-bar bg-success" role="progressbar" style="width: <%= progress %>%;">
                            </div>
                        </div>

                        <!-- STATUS CIRCLES -->
                        <div class="d-flex">
                            <div class="status-step">
                                <div
                                    class="status-circle <%= ['processing','shipped','delivered'].includes(status) ? 'status-active' : '' %>">
                                </div>
                                <small>PROCESSING</small>
                            </div>

                            <div class="status-step">
                                <div
                                    class="status-circle <%= ['shipped','delivered'].includes(status) ? 'status-active' : '' %>">
                                </div>
                                <small>SHIPPED</small>
                            </div>

                            <div class="status-step">
                                <div class="status-circle <%= status === 'delivered' ? 'status-active' : '' %>"></div>
                                <small>DELIVERED</small>
                            </div>
                        </div>
                    </div>

                    <!-- ORDER SUMMARY CARD -->
                    <div class="card mb-4">
                        <div class="card-body">

                            <div class="row mb-3">

                                <div class="col-md-3">
                                    <small class="text-muted">ORDER PLACED</small><br>
                                    <strong>
                                        <%= new Date(order.createdAt).toDateString() %>
                                    </strong>
                                </div>

                                <div class="col-md-2">
                                    <small class="text-muted">TOTAL</small><br>
                                    <strong>₹<%= order.totalAmount %></strong>
                                </div>

                                <div class="col-md-3">
                                    <small class="text-muted">ORDER ID</small><br>
                                    <strong>
                                        <%= order.orderId %>
                                    </strong>
                                </div>

                                <div class="col-md-2">
                                    <small class="text-muted">STATUS</small><br>
                                    <span class="badge bg-secondary">
                                        <%= order.status %>
                                    </span>
                                </div>

                                <div class="col-md-2 text-end">
                                    <a href="/order/<%= order._id %>/invoice" class="btn btn-primary btn-sm">
                                        View Invoice
                                    </a>
                                </div>

                            </div>

                        </div>
                    </div>

                    <!-- PRODUCT LIST -->
                    <div class="card mb-4">
                        <div class="card-body">

                            <h5 class="mb-3">Products</h5>

                            <% orderItems.forEach(item=> { %>

                                <div class="d-flex justify-content-between align-items-center mb-3">

                                    <div class="d-flex align-items-center">
                                        <img src="<%= item.image %>" width="60" class="me-3 rounded">

                                        <div>
                                            <a href="/product/<%= item.product_id %>/<%= item.variant_id %>"
                                                class="text-decoration-none text-dark">
                                                <strong>
                                                    <%= item.productName %>
                                                </strong><br>
                                                Qty: <%= item.quantity %><br>
                                                    Price: ₹<%= item.price %>
                                            </a>
                                        </div>
                                    </div>
                                </div>

                                <hr>

                                <% }) %>

                        </div>
                    </div>

                    <!-- SHIPPING ADDRESS -->
                    <div class="card mb-4">
                        <div class="card-body">

                            <h5 class="mb-3">Shipping Address</h5>

                            <strong>
                                <%= order.shippingAddress.fullName %>
                            </strong><br>
                            <%= order.shippingAddress.street %><br>
                                <%= order.shippingAddress.city %>,
                                    <%= order.shippingAddress.state %><br>
                                        Pin: <%= order.shippingAddress.pincode %><br>
                                            Phone: <%= order.shippingAddress.phone %>

                        </div>
                    </div>

            </div>

    </div>

    <%- include("../partials/user/footer") %>