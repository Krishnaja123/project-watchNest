<%- include("../partials/user/header", { title: "Order Details" , hideNavBar: true }) %>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/user/profile.css">
    <link rel="stylesheet" href="/css/user/userSidebar.css">

    <style>
        .status-wrapper {
            margin-bottom: 25px;
        }

        .progress {
            height: 8px;
            border-radius: 20px;
        }

        .status-step {
            text-align: center;
            flex: 1;
            position: relative;
        }

        .status-step:not(:last-child)::after {
            content: '';
            position: absolute;
            top: 10px;
            right: -50%;
            width: 100%;
            height: 2px;
            background: #ddd;
            z-index: 0;
        }

        .status-circle {
            width: 18px;
            height: 18px;
            border-radius: 50%;
            margin: 0 auto;
            background: #ccc;
            position: relative;
            z-index: 1;
        }

        .status-active {
            background: #28a745 !important;
        }
    </style>

    <!-- Breadcrumb -->
    <div class="container mt-3">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item">
                    <a href="/home">Home</a>
                </li>
                <li class="breadcrumb-item">
                    <a href="/orders">Your Orders</a>
                </li>
                <li class="breadcrumb-item active">
                    Order Details
                </li>
            </ol>
        </nav>
    </div>

    <div class="profile-layout">

        <%- include("../partials/user/userSidebar") %>

            <div class="profile-main">

                <h1 class="main-title">Order Details</h1>

                <% const status=order.status; let progress=0; if (status==="processing" ) progress=25; else if
                    (status==="confirmed" ) progress=50; else if (status==="shipped" ) progress=75; else if
                    (status==="delivered" ) progress=100; %>

                    <!-- STATUS PROGRESS BAR -->
                    <div class="status-wrapper">
                        <div class="progress mb-3">
                            <div class="progress-bar bg-success" role="progressbar" style="width: <%= progress %>">
                            </div>
                        </div>

                        <!-- STATUS CIRCLES -->
                        <div class="d-flex">
                            <div class="status-step">
                                <div
                                    class="status-circle <%= ['processing','shipped','delivered'].includes(status) ? 'status-active' : '' %>">
                                </div>
                                <small>PROCESSING</small>
                            </div>

                            <div class="status-step">
                                <div
                                    class="status-circle <%= ['shipped','delivered'].includes(status) ? 'status-active' : '' %>">
                                </div>
                                <small>SHIPPED</small>
                            </div>

                            <div class="status-step">
                                <div class="status-circle <%= status === 'delivered' ? 'status-active' : '' %>"></div>
                                <small>DELIVERED</small>
                            </div>
                        </div>
                    </div>

                    <!-- ORDER SUMMARY CARD -->
                    <div class="card mb-4">
                        <div class="card-body">

                            <div class="row mb-3">

                                <div class="col-md-3">
                                    <small class="text-muted">ORDER PLACED</small><br>
                                    <strong>
                                        <%= new Date(order.createdAt).toDateString() %>
                                    </strong>
                                </div>

                                <div class="col-md-2">
                                    <small class="text-muted">ORDER ID</small><br>
                                    <strong>
                                        <%= order.orderId %>
                                    </strong>
                                </div>

                                <div class="col-md-2">
                                    <small class="text-muted">PAYMENT</small><br>
                                    <strong>
                                        <%= order.paymentMethod %>
                                    </strong>
                                </div>

                                <div class="col-md-2">
                                    <small class="text-muted">PAYMENT STATUS</small><br>
                                    <span
                                        class="badge <%= order.paymentStatus === 'success' ? 'bg-success' : 'bg-danger' %>">
                                        <%= order.paymentStatus %>
                                    </span>
                                </div>

                                <div class="col-md-2">
                                    <small class="text-muted">STATUS</small><br>
                                    <span class="badge bg-secondary">
                                        <%= order.paymentStatus==="failed" && order.status !=="cancelled" ? "Pending" :
                                            order.status %>
                                    </span>
                                </div>

<div class="col d-flex justify-content-end align-items-start gap-2">                                    <% if (order.paymentStatus !=="failed" && !(order.status==="cancelled" &&
                                        order.paymentStatus==="pending" )) { %>
                                        <a href="/order/<%= order._id %>/invoice" class="btn btn-primary btn-sm">
                                            Invoice
                                        </a>
                                        <% } %>

                                            <% if (order.status==="processing" ) { %>
                                                <button type="button" class="btn btn-danger btn-sm cancel-order-btn"
                                                    data-id="<%= order._id %>">
                                                    Cancel Order
                                                </button>
                                                <% } %>
                                </div>

                            </div>

                        </div>
                    </div>
                    <!-- PRODUCT LIST -->
                    <div class="card mb-4">
                        <div class="card-body">

                            <h5 class="mb-3">Products</h5>

                            <% orderItems.forEach(item=> { %>

                                <div class="d-flex justify-content-between align-items-center mb-3">

                                    <div class="d-flex align-items-center">
                                        <img src="<%= item.image %>" width="60" class="me-3 rounded">

                                        <div>
                                            <a href="/product/<%= item.product_id %>/<%= item.variant_id %>"
                                                class="text-decoration-none text-dark">
                                                <strong>
                                                    <%= item.productName %>
                                                </strong><br>
                                                Qty: <%= item.quantity %><br>
                                                    Price: ₹<%= item.finalPrice %> <br>
                                            </a>
                                        </div>

                                        <div class="d-flex align-items-center gap-3">

                                            <!-- STATUS -->
                                            <span class="badge 
            <%= item.status === 'processing' ? 'bg-warning text-dark' :
                item.status === 'shipped' ? 'bg-primary' :
                item.status === 'delivered' ? 'bg-success' :
                item.status === 'cancelled' ? 'bg-danger' :
                item.status === 'returned' ? 'bg-dark' :
                'bg-secondary' %>">
                                                <%= order.paymentStatus==="failed" ? "Pending" : item.status %>
                                            </span>


                                        </div>
                                    </div>

                                    <div class="d-flex align-items-center gap-3">

                                                <!-- ACTION BUTTONS -->
                                                <% if (item.status==="processing" ) { %>
                                                    <button type="button"
                                                        class="btn btn-danger btn-sm cancel-product-btn"
                                                        data-id="<%= item._id %>">
                                                        Cancel
                                                    </button>
                                                    <% } else if (item.status==="delivered" ) { %>
                                                        <% if (!item.returnRequested && !item.returnAccepted &&
                                                            !item.returnRejected) { %>
                                                            <button type="button"
                                                                class="btn btn-outline-danger btn-sm return-product-btn"
                                                                data-id="<%= item._id %>">
                                                                Return
                                                            </button>
                                                            <% } else if(item.returnRequested && !item.returnAccepted &&
                                                                !item.returnRejected) { %>
                                                                <span class="badge bg-danger">
                                                                    Return Requested
                                                                </span>
                                                                <% } else if(item.returnAccepted) { %>
                                                                    <span class="badge bg-success">
                                                                        Return Accepted
                                                                    </span>
                                                                    <% } else if(item.returnRejected) { %>
                                                                        <span class="badge bg-danger">
                                                                            Return Rejected
                                                                        </span>
                                                                        <% } %>

                                                                            <% } %>

                                            </div>
                                </div>

                                <hr>

                                <% }) %>

                        </div>
                    </div>

                    <!-- PRICE DETAILS -->
                    <div class="card mb-4">
                        <div class="card-body">

                            <h5 class="mb-3">Price Details</h5>

                            <div class="d-flex justify-content-between">
                                <span>Original Price</span>
                                <span>₹<%= order.originalAmount.toFixed(2) %></span>
                            </div>

                            <% if(order.offerDiscount> 0) { %>
                                <div class="d-flex justify-content-between text-success">
                                    <span>Offer Discount</span>
                                    <span>- ₹<%= order.offerDiscount.toFixed(2) %></span>
                                </div>
                                <% } %>

                                    <% if(order.couponDiscount> 0) { %>
                                        <div class="d-flex justify-content-between text-success">
                                            <span>Coupon Discount (<%= order.couponCode %>)</span>
                                            <span>- ₹<%= order.couponDiscount.toFixed(2) %></span>
                                        </div>
                                        <% } %>

                                            <% if(order.shippingCharge> 0) { %>
                                                <div class="d-flex justify-content-between">
                                                    <span>Shipping Charge</span>
                                                    <span>₹<%= order.shippingCharge.toFixed(2) %></span>
                                                </div>
                                                <% } else { %>
                                                    <div class="d-flex justify-content-between text-success">
                                                        <span>Shipping</span>
                                                        <span>FREE</span>
                                                    </div>
                                                    <% } %>

                                                        <% if(order.taxAmount> 0) { %>
                                                            <div class="d-flex justify-content-between">
                                                                <span>Tax (GST)</span>
                                                                <span>₹<%= order.taxAmount.toFixed(2) %></span>
                                                            </div>
                                                            <% } %>

                                                                <hr>

                                                                <div class="d-flex justify-content-between fw-bold">
                                                                    <span>Total Amount</span>
                                                                    <span>₹<%= order.totalAmount %></span>
                                                                </div>

                        </div>
                    </div>

                    <!-- SHIPPING ADDRESS -->
                    <div class="card mb-4">
                        <div class="card-body">

                            <h5 class="mb-3">Shipping Address</h5>

                            <strong>
                                <%= order.shippingAddress.full_name %>
                            </strong><br>
                            <%= order.shippingAddress.street %><br>
                                <%= order.shippingAddress.city %>,
                                    <%= order.shippingAddress.state %><br>
                                        Pin: <%= order.shippingAddress.pincode %><br>
                                            Phone: <%= order.shippingAddress.phone %>

                        </div>
                    </div>

            </div>

    </div>

    <!-- Cancel Reason Modal -->
    <div class="modal fade" id="cancelModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title"></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <form id="cancelForm" method="POST">
                    <div class="modal-body">

                        <label for="reason" class="form-label">Select Reason</label>

                        <div class="form-check">
                            <select name="reasonSelect" id="reasonSelect" class="form-select">

                            </select>
                        </div>

                        <div id="otherReasonBox" class="mt-3" style="display: none;">
                            <label class="form-label">Please specify</label>
                            <input type="text" id="otherReasonInput" class="form-control"
                                placeholder="Enter your reason">
                        </div>

                        <input type="hidden" name="reason" id="finalReason">
                        <input type="hidden" name="from" value="/order-details">

                    </div>

                    <div class="modal-footer">
                        <button type="submit" class="btn btn-danger">Confirm Cancel</button>
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    </div>

                </form>

            </div>
        </div>
    </div>

    <%- include("../partials/user/footer") %>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js">
        </script>

        <script>

            const cancelOrderBtns = document.querySelectorAll(".cancel-order-btn");
            const cancelForm = document.getElementById("cancelForm");
            const cancelProductBtns = document.querySelectorAll(".cancel-product-btn");
            const returnProductBtns = document.querySelectorAll(".return-product-btn");

            const reasonSelect = document.getElementById("reasonSelect");
            const otherReasonBox = document.getElementById("otherReasonBox");
            const otherReasonInput = document.getElementById("otherReasonInput");
            const finalReason = document.getElementById("finalReason");

            const cancelReasons = [
                "Changed my mind",
                "Found better price",
                "Ordered by mistake",
                "Delivery taking too long",
                "Other"
            ];

            const returnReasons = [
                "Product defective",
                "Wrong item received",
                "Not as described",
                "Size/fit issue",
                "Other"
            ];

            function renderReasons(reasons) {
                reasonSelect.innerHTML = `<option value="" disabled selected>-- Choose reason --</option>`;

                reasons.forEach(reason => {
                    const option = document.createElement("option");
                    option.value = reason;
                    option.textContent = reason;
                    reasonSelect.appendChild(option);
                });
            }

            cancelOrderBtns.forEach(btn => {
                btn.addEventListener("click", function () {
                    const order_id = btn.getAttribute("data-id");

                    const modalTitle = document.querySelector("#cancelModal .modal-title");
                    modalTitle.innerText = "Cancel Reason";

                    renderReasons(cancelReasons);

                    cancelForm.action = `/orders/cancel/${order_id}`;

                    reasonSelect.value = "";
                    otherReasonInput.value = "";
                    finalReason.value = "";
                    otherReasonBox.style.display = "none";

                    const modal = document.getElementById("cancelModal");
                    const modalInstance = new bootstrap.Modal(modal);
                    modalInstance.show();
                });
            });

            cancelProductBtns.forEach(btn => {
                btn.addEventListener("click", function () {
                    const itemId = btn.getAttribute("data-id");

                    const modalTitle = document.querySelector("#cancelModal .modal-title");
                    modalTitle.innerText = "Cancel Reason";

                    renderReasons(cancelReasons);

                    cancelForm.action = `/orders/item-cancel/${itemId}`;

                    reasonSelect.value = "";
                    otherReasonInput.value = "";
                    finalReason.value = "";
                    otherReasonBox.style.display = "none";

                    const modal = document.getElementById("cancelModal");
                    const modalInstance = new bootstrap.Modal(modal);
                    modalInstance.show();
                });
            });

            returnProductBtns.forEach(btn => {
                btn.addEventListener("click", function () {
                    const itemId = btn.getAttribute("data-id");

                    const modalTitle = document.querySelector("#cancelModal .modal-title");
                    modalTitle.innerText = "Return Reason";

                    renderReasons(returnReasons);

                    cancelForm.action = `/orders/item-return/${itemId}`;

                    reasonSelect.value = "";
                    otherReasonInput.value = "";
                    finalReason.value = "";
                    otherReasonBox.style.display = "none";

                    const modal = document.getElementById("cancelModal");
                    const modalInstance = new bootstrap.Modal(modal);
                    modalInstance.show();
                });
            });

            reasonSelect.addEventListener("change", () => {
                if (reasonSelect.value === "Other") {
                    otherReasonBox.style.display = "block";
                } else {
                    otherReasonBox.style.display = "none";
                    otherReasonInput.value = "";
                }
            });

            cancelForm.addEventListener("submit", (e) => {
                e.preventDefault();

                if (!reasonSelect.value) {
                    Swal.fire({
                        icon: "warning",
                        text: "Please select the reason"
                    });
                    return;
                }

                if (reasonSelect.value === "Other") {
                    if (otherReasonInput.value.trim() === "") {
                        Swal.fire({
                            icon: "warning",
                            text: "Please specify the reason"
                        });
                        return;
                    }
                    finalReason.value = otherReasonInput.value;
                } else {
                    finalReason.value = reasonSelect.value;
                }

                Swal.fire({
                    title: "Are you sure?",
                    text: "Do you want to cancel this order?",
                    icon: "warning",
                    showCancelButton: true,
                    confirmButtonText: "Yes, cancel it"
                }).then((result) => {
                    if (result.isConfirmed) {
                        cancelForm.submit();
                    }
                });
            })



        </script>