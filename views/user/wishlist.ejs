<%- include("../partials/user/header", { title: "Wishlist" , hideNavBar: true }) %>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        body {
            background: #f4f5f7;
        }

        .container {
            max-width: 1200px;
        }

        h3 {
            font-weight: 600;
            margin-bottom: 30px;
        }

        .table {
            background: #ffffff;
            border-radius: 18px;
            overflow: hidden;
            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.06);
        }

        .table thead {
            background: #fafafa;
            font-weight: 600;
        }

        .table th {
            border: none;
            padding: 16px;
        }

        .table td {
            vertical-align: middle;
            padding: 16px;
            border-top: 1px solid #f1f1f1;
        }

        .btn-add {
            border-radius: 20px;
            border: 1px solid #c8a27c;
            color: #c8a27c;
            background: transparent;
            padding: 6px 14px;
            transition: 0.3s ease;
        }

        .btn-add:hover {
            background: #c8a27c;
            color: #fff;
        }

        .btn-remove {
            border-radius: 20px;
            border: 1px solid #dc3545;
            background: transparent;
            color: #dc3545;
            padding: 6px 14px;
            transition: 0.3s ease;
        }

        .btn-remove:hover {
            background: #dc3545;
            color: #fff;
        }

        .wishlist-empty {
            text-align: center;
            padding: 40px;
        }

        a img {
            cursor: pointer;
            transition: 0.3s;
        }

        a img:hover {
            transform: scale(1.05);
        }
    </style>

    <div class="container my-5">

        <!-- Breadcrumb -->
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/home">Home</a></li>
                <li class="breadcrumb-item"><a href="/products">Shop</a></li>
                <li class="breadcrumb-item active">Wishlist</li>
            </ol>
        </nav>

        <h3 class="text-center">My Wishlist ❤️</h3>

        <div class="table-responsive">
            <table class="table table-bordered text-center align-middle">
                <thead>
                    <tr>
                        <th>Image</th>
                        <th>Name</th>
                        <th>Price</th>
                        <th>Add to Cart</th>
                        <th>Remove</th>
                    </tr>
                </thead>

                <tbody>
                    <% if (wishlist && wishlist.products.length> 0) { %>

                        <% wishlist.products.forEach(item=> { %>

                            <% const variant=item.product_id.variants.find(v=>
                                v._id.toString() === item.variant_id.toString()
                                );
                                %>

                                <% if (variant) { %>

                                    <tr>
                                        <td>
                                            <a href="/product/<%= item.product_id._id %>/<%= variant._id %>">
                                                <img src="<%= variant.images[0] %>" style="width:60px;">
                                            </a>
                                        </td>

                                        <td>
                                            <%= item.product_id.name %>
                                        </td>

                                        <td>
                                            ₹<%= variant.price.toString() %>
                                        </td>

                                        <td>
                                            <button class="btn btn-add add-to-cart-btn"
                                                data-product-id="<%= item.product_id._id %>"
                                                data-variant-id="<%= variant._id %>">
                                                Add to Cart
                                            </button>
                                        </td>

                                        <td>
                                            <button class="btn btn-remove remove-wishlist-btn"
                                                data-product-id="<%= item.product_id._id %>"
                                                data-variant-id="<%= variant._id %>">
                                                REMOVE
                                            </button>
                                        </td>
                                    </tr>

                                    <% } %>

                                        <% }) %>

                                            <% } else { %>

                                                <tr>
                                                    <td colspan="6" class="wishlist-empty">
                                                        Your wishlist is empty 💔 <br>
                                                        <a href="/products">Continue Shopping</a>
                                                    </td>
                                                </tr>

                                                <% } %>
                </tbody>
            </table>
        </div>

    </div>

    <%- include("../partials/user/footer") %>

        <script>

            const message = "<%= message %>";
            const type = "<%= type %>";

            if (message && message.trim() !== '') {
                Swal.fire({ icon: type, text: message, confirmButtonColor: '#007bff' });
            }

document.querySelectorAll(".remove-wishlist-btn").forEach(btn => {
    btn.addEventListener("click", async function () {

        const productId = this.dataset.productId;
        const variantId = this.dataset.variantId;

        const result = await Swal.fire({
            title: "Are you sure?",
            text: "This product will be removed from your wishlist!",
            icon: "warning",
            showCancelButton: true,
            confirmButtonColor: "#dc3545",
            cancelButtonColor: "#6c757d",
            confirmButtonText: "Yes, remove it!",
            cancelButtonText: "Cancel"
        });

        if (!result.isConfirmed) return;

        const res = await fetch("/remove-from-wishlist", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ productId, variantId })
        });

        const data = await res.json();

        if (data.success) {
            await Swal.fire({
                title: "Removed!",
                text: "Product removed from wishlist",
                icon: "success",
                timer: 1500,
                showConfirmButton: false
            });

            location.reload();
        } else {
            Swal.fire("Error", "Failed to remove item", "error");
        }
    });
});

            document.querySelectorAll(".add-to-cart-btn").forEach(btn => {
                btn.addEventListener("click", async function () {
                    console.log("hi");

                    const productId = this.dataset.productId;
                    const variantId = this.dataset.variantId;

                    const res = await fetch("/wishlist/move-to-cart", {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify({ productId, variantId })
                    });

                    const data = await res.json();

                    if (data.success) {

                        this.closest("tr").remove();

                        Swal.fire({
                            icon: "success",
                            text: data.message,
                            confirmButtonColor: '#007bff'
                        }).then(() => {
                            location.reload();
                        });

                    } else {
                        Swal.fire({
                            icon: "error",
                            text: data.message,
                            confirmButtonColor: '#007bff'
                        })
                    }
                });
            });
        </script>