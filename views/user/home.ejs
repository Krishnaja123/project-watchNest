<%- include("../partials/user/header") %>

    <link rel="stylesheet" href="/css/user/home.css">

    <main>
        <section class="banner">
            <div class="banner-slider">
                <div class="slide active" style="background-image: url('/images/banner/banner1.jpg')"></div>
                <div class="slide" style="background-image: url('/images/banner/banner2.jpg')"></div>
                <div class="slide" style="background-image: url('/images/banner/banner3.jpg')"></div>
            </div>

            <div class="banner-content">
                <h1>SUMMER COLLECTION 2023</h1>
                <p>Discover our new arrivals</p>
                <a href="/products">
                    <button style=" margin-top: 20px; padding: 10px 30px; background: #f1eded; 
                        color: rgb(0, 0, 0); border: none; border-radius: 25px; cursor: pointer;">SHOP
                        NOW</button>
                </a>
            </div>
        </section>


        <!-- Products -->
        <div class="section-title">
            <h2>New Products</h2>
            <a href="/products" class="view-all">
                View All <i class="fas fa-arrow-right"></i>
            </a>
        </div>

        <div class="products-grid">
            <% showData.forEach(data=> { %>
                <div class="product-card">

                    <div class="wishlist" data-product-id="<%= data.productId %>"
                        data-variant-id="<%= data.variantId %>">
                        <i
                            class="fa fa-heart <%= (wishlistProductIds || []).includes(data.productId.toString()) ? 'active' : '' %>"></i>
                    </div>
                    <a href="/product/<%= data.productId %>/<%= data.variantId %>" class="product-link">

                        <div class="product-image">
                            <img src="<%= data.image %>" alt="">
                        </div>

                        <div class="product-info">
                            <h3 class="product-title">
                                <%= data.name %>
                            </h3>

                            <p class="brand">Brand: <%= data.brand %>
                            </p>

                            <div class="price-section">
                                <% if(data.discount> 0) { %>

                                    <!-- Original Price -->
                                    <span class="original-price">₹<%= data.price %></span>

                                    <!-- Discounted Price -->
                                    <span class="final-price">₹<%= data.finalPrice %></span>

                                    <!-- Discount Badge -->
                                    <span class="discount-badge">
                                        ₹<%= data.discount %> OFF
                                    </span>

                                    <% } else { %>

                                        <!-- Normal Price -->
                                        <span class="price">₹<%= data.price %></span>

                                        <% } %>
                            </div>
                        </div>
                    </a>

                    <button class="add-cart-btn" data-product-id="<%= data.productId %>"
                        data-variant-id="<%= data.variantId %>">
                        Add to Cart
                    </button>
                </div>

                <% }) %>
        </div>
    </main>

    <%- include('../partials/user/footer') %>

        <script>

            // const data = <%- JSON.stringify(showData) %>
            // console.log("show data: ", data);

            document.addEventListener('DOMContentLoaded', function () {
                document.querySelectorAll(".add-cart-btn").forEach(button => {
                    button.addEventListener("click", async function () {

                        const productId = this.dataset.productId;
                        const variantId = this.dataset.variantId;

                        if (!productId || !variantId) {
                            Swal.fire("Error", "Invalid product data", "error");
                            return;
                        }
                        console.log("productId: ", productId);
                        console.log("variantId: ", variantId);

                        const response = await fetch("/cart/add", {
                            method: "POST",
                            headers: { "Content-Type": "application/json" },
                            body: JSON.stringify({ productId, variantId })
                        });

                        const result = await response.json();


                        if (result.success) {

                            Swal.fire({
                                title: "Added to Cart",
                                text: result.message,
                                icon: "success",
                                timer: 1500,
                                showConfirmButton: false
                            }).then(() => {
                                location.reload();
                            });

                        } else {

                            Swal.fire({
                                title: "Error!",
                                text: result.message,
                                icon: "error",
                                timer: 2000,
                                showConfirmButton: false
                            });

                        }

                    })
                })

                document.querySelectorAll(".wishlist").forEach(button => {
                    button.addEventListener("click", async function () {
                        const productId = this.dataset.productId;
                        const variantId = this.dataset.variantId;

                        const icon = this.querySelector("i");

                        console.log("Clicked productId:", productId);

                        try {
                            const res = await fetch("/toggle-wishlist", {
                                method: "POST",
                                headers: {
                                    "Content-Type": "application/json"
                                },
                                body: JSON.stringify({ productId, variantId })
                            });

                            const data = await res.json();

                            let message = "";

                            if (data.added) {
                                icon.classList.add("active");
                                message = "Product added to wishlist successfully";
                            } else {
                                icon.classList.remove("active");
                                message = "Product removed from wishlist successfully";
                            }

                            Swal.fire({
                                title: "Success",
                                text: message,
                                icon: "success",
                                timer: 2000,
                                showConfirmButton: false
                            }).then(() => {
                                location.reload();
                            });;

                        } catch (error) {
                            console.error("Wishlist error:", error);

                            Swal.fire({
                                title: "Error",
                                text: "Something went wrong!",
                                icon: "error"
                            });
                        }
                    });
                });
            })

        </script>