<%- include("../partials/admin/header", { title: "Order Details" }) %>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/admin/sidebar.css">
    <link rel="stylesheet" href="/css/admin/admin.css">

    <div class="container-fluid">
        <div class="row">

            <!-- Sidebar -->
            <%- include("../partials/admin/sidebar") %>

                <!-- Main Content -->
                <div class="col-md-10 p-4">

                    <h2 class="mb-4">Order Details</h2>


                    <div class="d-flex justify-content-end mb-3">
                        <a href='/admin/orders?page=<%= page %>' class="btn btn-secondary">← Go Back</a>
                    </div>

                    <% const status=order.status; %>
                        <!-- <% const OrderStatusFlow={ processing: ["processing","shipped","cancelled"],
                            shipped: ["shipped","delivered"], delivered: ["delivered"], cancelled: ["cancelled"],
                            returned: ["returned"] }; %> -->

                        <!-- ORDER SUMMARY -->
                        <div class="card mb-4">
                            <div class="card-body">

                                <div class="row">

                                    <div class="col-md-3">
                                        <small class="text-muted">ORDER DATE</small><br>
                                        <strong>
                                            <%= new Date(order.createdAt).toDateString() %>
                                        </strong>
                                    </div>

                                    <div class="col-md-3">
                                        <small class="text-muted">ORDER ID</small><br>
                                        <strong>
                                            <%= order.orderId %>
                                        </strong>
                                    </div>

                                    <div class="col-md-2">
                                        <small class="text-muted">TOTAL</small><br>
                                        <strong>₹<%= order.totalAmount %></strong>
                                    </div>

                                    <div class="col-md-2">
                                        <small class="text-muted">PAYMENT</small><br>
                                        <span class="badge 
    <%= order.paymentStatus === 'pending' ? 'bg-warning text-dark' :
        order.paymentStatus === 'paid' ? 'bg-success' :
        order.paymentStatus === 'failed' ? 'bg-danger' :
        order.paymentStatus === 'refunded' ? 'bg-info text-dark' :
        'bg-secondary' %>">
                                            <%= order.paymentStatus %>
                                        </span>
                                    </div>

                                    <div class="col-md-2">
                                        <small class="text-muted">CURRENT STATUS</small><br>
                                        <span class="badge bg-secondary">
                                            <%= order.status %>
                                        </span>
                                    </div>

                                    <% if(order.offerDiscount) { %>
                                        <div class="col-md-2">
                                            <small class="text-muted">OFFER DISCOUNT</small><br>
                                            <strong>
                                                <%= order.offerDiscount %>
                                            </strong>
                                        </div>
                                        <% } %>

                                            <% if(order.couponDiscount) { %>
                                                <div class="col-md-2">
                                                    <small class="text-muted">COUPON DISCOUNT</small><br>
                                                    <strong>
                                                        <%= order.couponDiscount %>
                                                    </strong>
                                                </div>
                                                <% } %>


                                </div>

                            </div>
                        </div>

                        <!-- EDIT ORDER STATUS 
                            <div class="card mb-4">
                                <div class="card-body">

                                    <h5>Update Order Status</h5>

                                    <form action="/admin/order-status/<%= order._id %>" method="POST">

                                        <div class="row align-items-center">

                                            <div class="col-md-4">
                                                <select name="status" class="form-select" required>
                                                    <option value="processing" <%=status==="pending" ? "selected" : ""
                                                        %>
                                                        >Processing</option>
                                                    <option value="shipped" <%=status==="shipped" ? "selected" : "" %>
                                                        >Shipped</option>
                                                    <option value="delivered" <%=status==="delivered" ? "selected" : ""
                                                        %>
                                                        >Delivered</option>
                                                    <option value="cancelled" <%=status==="cancelled" ? "selected" : ""
                                                        %>
                                                        >Cancelled</option>
                                                    <option value="returned" <%=status==="returned" ? "selected" : "" %>
                                                        >Returned</option>
                                                </select>
                                            </div>

                                            <div class="col-md-3">
                                                <button type="submit" class="btn btn-primary">
                                                    Update Status
                                                </button>
                                            </div>

                                        </div>

                                    </form>

                                </div>
                            </div>

                            -->

                        <!-- PRODUCT LIST -->
                        <% const productStatusFlow={ processing: ["processing","shipped","cancelled"], shipped:
                            ["shipped","delivered"], delivered: ["delivered","returned"], cancelled: ["cancelled"],
                            returned: ["returned"] }; %>

                            <div class="card mb-4">
                                <div class="card-body">

                                    <h5 class="mb-3">Ordered Products</h5>

                                    <% orderItems.forEach(item=> { %>

                                        <% const endStatus=(item.returnRequested && item.returnAccepted) ?
                                            ["cancelled", "returned" ] : ["cancelled", "returned" , "delivered" ]; %>

                                            <div class="row mb-3 align-items-center">

                                                <div class="col-md-2">
                                                    <img src="<%= item.image %>" class="img-fluid rounded">
                                                </div>

                                                <div class="col-md-6">
                                                    <strong>
                                                        <%= item.productName %>
                                                    </strong><br>
                                                    Quantity: <%= item.quantity %><br>
                                                        Original Price:
                                                         ₹<%= item.price %> <br>
                                                    Offer Price: 
                                                    <strong>₹<%= item.finalPrice %></strong><br>
<strong>Total: <%= item.quantity * item.finalPrice %></strong>

                                                </div>

                                                <div class="col-md-2">
                                                    <strong>Status:</strong><br>

                                                    <span class="badge 
    <%= item.status === 'processing' ? 'bg-warning text-dark' :
        item.status === 'shipped' ? 'bg-primary' :
        item.status === 'delivered' ? 'bg-success' :
        item.status === 'cancelled' ? 'bg-danger' :
        item.status === 'returned' ? 'bg-dark' :
        'bg-secondary' %>">
                                                        <%= item.status %>
                                                    </span>
                                                    <% if(item.status==="cancelled" ) { %>
                                                        <div class="mt-2 p-2 rounded"
                                                            style="background-color:#f8f9fa; border-left: 4px solid #dc3545;">
                                                            <small class="text-muted">
                                                                <strong>Cancel Reason:</strong><br>
                                                                <%= item.cancelReason || order.cancelReason %>
                                                            </small>
                                                        </div>
                                                        <% } %>

                                                            <% if(item.status==="delivered" &&
                                                                item.returnRequested===true) { %>
                                                                <div class="mt-2">
                                                                    <% if(item.returnRejected===false &&
                                                                        item.returnAccepted===false) { %>
                                                                        <button type="button"
                                                                            class="btn btn-danger btn-sm return-accept-btn"
                                                                            data-id="<%= item._id %>">
                                                                            Handle Return
                                                                        </button>
                                                                        <% } %>
                                                                            <% if(item.returnAccepted) { %>
                                                                                <span class="badge bg-success">
                                                                                    Return Accepted
                                                                                </span>
                                                                                <% } else if(item.returnRejected) { %>
                                                                                    <span class="badge bg-danger">
                                                                                        Return Rejected
                                                                                    </span>
                                                                                    <% } %>
                                                                                        <small class="text-muted">
                                                                                            <strong><br>Return
                                                                                                Reason:</strong>
                                                                                            <%= item.returnReason %>
                                                                                        </small>
                                                                </div>

                                                                <% } %>

                                                                    <div>
                                                                        <% if(item.status==="returned" ) { %>
                                                                            <small class="text-muted">
                                                                                <strong><br>Return
                                                                                    Reason:</strong>
                                                                                <%= item.returnReason %>
                                                                            </small>
                                                                            <% } %>
                                                                    </div>
                                                </div>


                                                <div>

                                                    <% if(!endStatus.includes(item.status)){ %>

                                                        <form action="/admin/order-item-status/<%= item._id %>"
                                                            method="POST"
                                                            class="statusForm d-flex align-items-center gap-2">

                                                            <select name="status" class="form-select form-select-sm">

                                                                <% productStatusFlow[item.status].forEach(statusOption=>
                                                                    { %>

                                                                    <option value="<%= statusOption %>"
                                                                        <%=statusOption===item.status ? "selected" : ""
                                                                        %>>

                                                                        <%= statusOption.charAt(0).toUpperCase() +
                                                                            statusOption.slice(1) %>

                                                                    </option>

                                                                    <% }) %>

                                                            </select>

                                                            <button type="submit" class="btn btn-sm btn-primary">
                                                                Update
                                                            </button>

                                                        </form>

                                                        <% } else { %>

                                                            <span class="text-muted">No actions
                                                                available</span>

                                                            <% } %>

                                                </div>
                                            </div>

                                            <hr>

                                            <% }) %>

                                </div>
                            </div>

                            <!-- SHIPPING ADDRESS -->
                            <div class="card">
                                <div class="card-body">

                                    <h5>Shipping Address</h5>

                                    <strong>
                                        <%= order.shippingAddress?.fullName || "N/A" %>
                                    </strong><br>
                                    <%= order.shippingAddress?.street || "" %><br>
                                        <%= order.shippingAddress?.city || "" %>,
                                            <%= order.shippingAddress?.state || "" %><br>
                                                Pin: <%= order.shippingAddress?.pincode || "" %><br>
                                                    Phone: <%= order.shippingAddress?.phone || "" %>
                                </div>
                            </div>
                </div>
        </div>
    </div>

    <%- include("../partials/admin/footer") %>

        <script>
            const message = "<%= message %>";
            const type = "<%= type %>";
            if (message) {
                Swal.fire({
                    title: type,
                    icon: type,
                    text: message,
                    confirmButtonColor: '#007bff',
                    confirmButtonText: "OK",
                    // timer: 2000,
                    timerProgressBar: true,
                });
            }

            document.addEventListener("DOMContentLoaded", function () {

                const returnRequests = document.querySelectorAll(".return-accept-btn");
                returnRequests.forEach(btn => {
                    btn.addEventListener("click", function () {
                        const itemId = btn.getAttribute("data-id");

                        Swal.fire({
                            title: "Return Request",
                            text: "Do you want to accept or reject this return request?",
                            icon: "question",
                            showCancelButton: true,
                            showDenyButton: true,

                            confirmButtonText: "Accept",
                            denyButtonText: "Reject",
                            cancelButtonText: "Cancel",

                            confirmButtonColor: "#28a745",
                            denyButtonColor: "#dc3545"
                        }).then((result) => {

                            if (result.isConfirmed || result.isDenied) {

                                const form = document.createElement("form");
                                form.method = "POST";
                                form.action = `/admin/order-item-return/${itemId}`;

                                const actionInput = document.createElement("input");
                                actionInput.type = "hidden";
                                actionInput.name = "action";
                                actionInput.value = result.isConfirmed ? "acceptReturn" : "rejectReturn";

                                form.appendChild(actionInput);

                                document.body.appendChild(form);
                                form.submit();
                            }

                        });
                    })
                })
            })
        </script>